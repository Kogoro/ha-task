{
  "entity": {
    "binary_sensor": {
      "overdue": {
        "default": "mdi:alert-circle"
      },
      "area_overdue": {
        "default": "mdi:alert"
      }
    },
    "sensor": {
      "days_until_due": {
        "default": "mdi:clipboard-check-outline"
      },
      "overdue_count": {
        "default": "mdi:alert-circle-outline"
      },
      "due_today": {
        "default": "mdi:calendar-today"
      },
      "due_this_week": {
        "default": "mdi:calendar-week"
      },
      "due_soon": {
        "default": "mdi:calendar-alert"
      },
      "status": {
        "default": "mdi:clipboard-text-clock-outline",
        "state": {
          "ok": "mdi:check-circle-outline",
          "due_soon": "mdi:clock-alert-outline",
          "overdue": "mdi:alert-circle"
        }
      }
    },
    "button": {
      "complete": {
        "default": "mdi:check-circle"
      },
      "assign_to_me": {
        "default": "mdi:account-arrow-left"
      }
    }
  },
  "services": {
    "complete_task": {
      "service": "mdi:check-circle"
    },
    "reset_task": {
      "service": "mdi:restart"
    },
    "undo_completion": {
      "service": "mdi:undo"
    },
    "get_history": {
      "service": "mdi:history"
    },
    "set_away": {
      "service": "mdi:airplane"
    },
    "clear_away": {
      "service": "mdi:home-account"
    },
    "export_config": {
      "service": "mdi:export"
    },
    "import_config": {
      "service": "mdi:import"
    }
  }
}
